rules_version = '2';

// Reglas de seguridad de VOXDEI.
//
// Idea central: cada iglesia es un grupo cerrado identificado por su groupId
// (el uid del pastor que la registró). Un usuario solo puede leer y escribir
// datos de SU iglesia. La Biblia es contenido común de solo lectura.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Ayudas ----

    function autenticado() {
      return request.auth != null;
    }

    // Documento del usuario que hace la petición.
    function miPerfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function miGroupId() {
      return miPerfil().groupId;
    }

    // Manda en la iglesia. Solo hay dos niveles: Pastor/Pastora y Operador.
    function soyPastor() {
      return miPerfil().role in ['Pastor', 'Pastora'];
    }

    // El dueño es quien registró la iglesia: su uid ES el groupId.
    function soyElDueno() {
      return autenticado() && request.auth.uid == miGroupId();
    }

    function esMiIglesia(groupId) {
      return autenticado() && miGroupId() == groupId;
    }

    // Campos que cambian en esta escritura.
    function camposTocados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---- Contenido de cada iglesia ----
    // predicas, tickers, messages, cronograma... viven aquí dentro.
    //
    // El cronograma (quién proyecta en cada servicio) lo lee toda la iglesia
    // pero solo lo escriben pastor y pastora. Va como condición dentro de esta
    // misma regla y no como un match aparte: en Firestore basta con que UNA
    // regla permita, así que un match propio más estricto no le quitaría al
    // operador el permiso que ya le da este.
    match /iglesias/{groupId}/{coleccion}/{documento=**} {
      allow read: if esMiIglesia(groupId);
      allow write: if esMiIglesia(groupId) &&
        (coleccion != 'cronograma' || soyPastor());
    }

    // ---- Usuarios ----

    // El rol y la iglesia NO se editan desde el cliente. Los asigna el servidor
    // (crearUsuarioAdmin) con permisos de administrador, que se saltan estas
    // reglas. Aquí solo se permite lo mínimo: que cada quien cambie su foto.
    match /users/{uid} {
      // Cada quien ve su perfil; el resto, solo gente de su misma iglesia.
      allow read: if autenticado() &&
                     (request.auth.uid == uid ||
                      resource.data.groupId == miGroupId());

      // Solo al registrar una iglesia nueva: el documento es propio, nace como
      // Pastor o Pastora y su groupId es su propio uid, o sea, es el dueño.
      // Así nadie puede crearse una ficha dentro de la iglesia de otro.
      allow create: if autenticado() &&
                       request.auth.uid == uid &&
                       request.resource.data.groupId == uid &&
                       request.resource.data.role in ['Pastor', 'Pastora'];

      // Cada quien cambia SOLO su foto. Nada de rol, iglesia, correo ni nombre:
      // si el rol fuera editable, cualquiera se ascendería a Pastor desde la
      // consola del navegador y entraría a la gestión de cuentas.
      allow update: if autenticado() &&
                       request.auth.uid == uid &&
                       camposTocados().hasOnly(['photo']);

      // Borrar cuentas pasa por el servidor; esta regla es la segunda barrera,
      // por si alguien lo intenta desde fuera de la app.
      //
      // Un pastor borra operadores de su iglesia. A la pareja pastoral solo la
      // borra el dueño, y al dueño (uid == su propio groupId) nadie.
      allow delete: if soyPastor() &&
                       resource.data.groupId == miGroupId() &&
                       request.auth.uid != uid &&
                       uid != resource.data.groupId &&
                       (soyElDueno() ||
                        !(resource.data.role in ['Pastor', 'Pastora']));
    }

    // ---- Imágenes ----
    // Colección en la raíz con campo groupId (se filtra por consulta).

    match /imagenes/{imagenId} {
      allow read, delete: if autenticado() && resource.data.groupId == miGroupId();
      allow create: if autenticado() && request.resource.data.groupId == miGroupId();
      allow update: if autenticado() &&
                       resource.data.groupId == miGroupId() &&
                       request.resource.data.groupId == miGroupId();
    }

    // ---- Canciones ----
    // Catálogo COMPARTIDO por todas las iglesias: cualquiera con sesión lo lee
    // y puede aportar canciones nuevas, pero solo la iglesia que subió una
    // canción puede modificarla o borrarla.

    match /canciones/{cancionId} {
      allow read: if autenticado();

      allow create: if autenticado() &&
                       request.resource.data.creadoPor == miGroupId();

      allow update: if autenticado() &&
                       resource.data.creadoPor == miGroupId() &&
                       request.resource.data.creadoPor == resource.data.creadoPor;

      allow delete: if autenticado() && resource.data.creadoPor == miGroupId();
    }

    // ---- Biblia ----
    // Contenido común: cualquiera con sesión la lee, nadie la modifica desde
    // la app (se carga con los scripts de Upload usando credenciales de admin).

    match /biblia/{documento} {
      allow read: if autenticado();
      allow write: if false;
    }

    // Todo lo demás queda cerrado. Esto incluye las colecciones antiguas
    // predicas/, tickers/ y messages/ de la raíz, que ya no se usan.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
