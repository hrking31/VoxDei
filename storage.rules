rules_version = '2';

// Reglas de los archivos de VOXDEI (Firebase Storage).
//
// Misma idea que en Firestore: cada iglesia solo toca lo suyo.
//   users/{uid}/...        fotos de perfil
//   imagenes/{groupId}/... imágenes que se proyectan

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() {
      return request.auth != null;
    }

    // La iglesia se reconoce igual que en la Realtime Database, SIN consultar
    // Firestore:
    //   - request.auth.uid == groupId  → el pastor dueño (su uid ES el groupId)
    //   - request.auth.token.groupId   → custom claim que pone crearUsuarioAdmin
    //
    // Antes esto se resolvía con firestore.get() sobre users/{uid}. Esa llamada
    // entre servicios necesita habilitación y permisos aparte del agente de
    // Storage; cuando no puede resolverse la regla no falla con un error, se
    // evalúa como falsa, y toda subida moría con 403 (storage/unauthorized).
    function miIglesia(groupId) {
      return request.auth.uid == groupId ||
             request.auth.token.groupId == groupId;
    }

    // Solo imágenes y de hasta 10 MB: evita que se suba cualquier archivo.
    function esImagenValida() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 10 * 1024 * 1024;
    }

    // ---- Fotos de perfil ----
    // No se consulta Firestore a propósito: al registrarse, la foto se sube
    // ANTES de que exista la ficha del usuario.
    match /users/{uid}/{archivo=**} {
      allow read: if autenticado();
      allow write: if autenticado() &&
                      request.auth.uid == uid &&
                      esImagenValida();
      allow delete: if autenticado() && request.auth.uid == uid;
    }

    // ---- Imágenes para proyectar ----
    match /imagenes/{groupId}/{archivo=**} {
      allow read: if autenticado() && miIglesia(groupId);
      allow write: if autenticado() &&
                      miIglesia(groupId) &&
                      esImagenValida();
      allow delete: if autenticado() && miIglesia(groupId);
    }

    // Todo lo demás queda cerrado.
    match /{rutas=**} {
      allow read, write: if false;
    }
  }
}
