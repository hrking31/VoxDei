{
  // Reglas de la Realtime Database de VOXDEI.
  //
  // Todo el estado de proyección cuelga de <nodo>/{groupId}. Un usuario solo
  // puede leer y escribir en el nodo de su propia iglesia.
  //
  // El groupId se reconoce por dos vías:
  //   - auth.uid === groupId       → el pastor dueño (su uid ES el groupId)
  //   - auth.token.groupId         → custom claim, que asigna la Cloud Function
  //                                  crearUsuarioAdmin al crear al usuario
  //
  // Todo usuario nace con su claim puesto, porque crearUsuarioAdmin es la única
  // vía de creación desde que ViewUsers dejó de crear cuentas en el cliente.
  // Al pastor dueño se le reconoce por su uid, así que tampoco lo necesita.
  "rules": {
    "$nodo": {
      "$groupId": {
        ".read": "auth != null && (auth.uid === $groupId || auth.token.groupId === $groupId)",
        ".write": "auth != null && (auth.uid === $groupId || auth.token.groupId === $groupId) && $nodo.matches(/^(displayTitulo|displayMessage|displayVersiculo|displayTicker|displayImage|displayVideo|displayVisibleTitulo|displayVisibleTexto|displayVisibleTicker|displayVisibleImagen|displayVisibleVideo|speedTicker)$/)"
      }
    }
  }
}
